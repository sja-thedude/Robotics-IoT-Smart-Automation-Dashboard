# ═══════════════════════════════════════════════════════════════════════
#  RoboGrid AI — environment configuration
#  Copy to `.env` and adjust. NEVER commit the real .env file.
# ═══════════════════════════════════════════════════════════════════════

# ── Django ─────────────────────────────────────────────────────────────
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-to-a-50-char-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1

# ── PostgreSQL ─────────────────────────────────────────────────────────
POSTGRES_DB=robogrid
POSTGRES_USER=robogrid
POSTGRES_PASSWORD=robogrid_pass
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ── Redis (cache, channels layer, celery broker/result) ────────────────
REDIS_URL=redis://redis:6379/0
CHANNELS_REDIS_URL=redis://redis:6379/1
CELERY_BROKER_URL=redis://redis:6379/2
CELERY_RESULT_BACKEND=redis://redis:6379/3

# ── MQTT broker ────────────────────────────────────────────────────────
MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_KEEPALIVE=60
MQTT_TLS=False
MQTT_BASE_TOPIC=robogrid

# ── JWT ────────────────────────────────────────────────────────────────
JWT_ACCESS_TTL_MINUTES=30
JWT_REFRESH_TTL_DAYS=7

# ── Observability ──────────────────────────────────────────────────────
SENTRY_DSN=
